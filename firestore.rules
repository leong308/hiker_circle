// Firestore authorization: current mobile session authority, canonical ownership, and server-only business mutations.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.uid is string
        && request.auth.token.phoneNumber == request.auth.uid
        && request.auth.token.get('mfa', false) == true
        && request.auth.token.get('mobileSessionId', '') != ''
        && get(/databases/$(database)/documents/mobileSessions/$(request.auth.uid)).data.activeSessionId
          == request.auth.token.mobileSessionId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountDisabled', false) == false
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'disabled';
    }

    // A displaced owner can observe the replacement notice, but cannot keep
    // accessing protected application data. Session ownership is server-only.
    match /mobileSessions/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId
        && request.auth.token.get('mfa', false) == true;
      allow list, write: if false;
    }

    match /mobileSessionCandidates/{sessionId} {
      allow read, write: if false;
    }

    match /sessionSecurityOutbox/{noticeId} {
      allow read, write: if false;
    }

    function phoneNumber() {
      return request.auth.token.phoneNumber;
    }

    function phoneKey() {
      return phoneNumber().replace('[^0-9]', '');
    }

    // Account roles are server/admin-owned. Read current authority rather than
    // a login-time claim so promotion and revocation apply to existing sessions.
    function administratorAccount(account) {
      return account.get('isAdmin', false) == true
        || account.get('isSuperAdmin', false) == true
        || (account.get('role', '') is string
          && account.get('role', '').lower() in ['admin', 'super_admin', 'superadmin', 'super-admin'])
        // Rules cannot map list strings to lowercase. These exact variants
        // match the app's case-insensitive role policy without substring grants.
        || (account.get('roles', []) is list
          && account.get('roles', []).hasAny([
            'super_admin', 'superadmin', 'super-admin', 'SUPER_ADMIN', 'SUPERADMIN', 'SuperAdmin',
            'admin', 'admiN', 'admIn', 'admIN', 'adMin', 'adMiN', 'adMIn', 'adMIN',
            'aDmin', 'aDmiN', 'aDmIn', 'aDmIN', 'aDMin', 'aDMiN', 'aDMIn', 'aDMIN',
            'Admin', 'AdmiN', 'AdmIn', 'AdmIN', 'AdMin', 'AdMiN', 'AdMIn', 'AdMIN',
            'ADmin', 'ADmiN', 'ADmIn', 'ADmIN', 'ADMin', 'ADMiN', 'ADMIn', 'ADMIN'
          ]));
    }

    function admin() {
      return signedIn()
        && administratorAccount(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        );
    }

    function participant(data) {
      return signedIn() && (
        (data.keys().hasAny(['hostPhoneNumber'])
          && data.hostPhoneNumber == phoneNumber())
        || (data.keys().hasAny(['creatorPhone'])
          && data.creatorPhone == phoneNumber())
        || (data.keys().hasAny(['participantPhones'])
          && data.participantPhones is list
          && phoneNumber() in data.participantPhones)
        || (data.keys().hasAny(['participantPhoneNumbers'])
          && data.participantPhoneNumbers is list
          && phoneNumber() in data.participantPhoneNumbers)
      );
    }

    function groupChatParticipant(data) {
      // Keep this predicate directly aligned with the client's
      // array-contains query so Firestore can prove every returned document.
      return signedIn() && phoneNumber() in data.participantPhones;
    }

    function upcomingHikeParticipant(data) {
      // Keep both branches directly aligned with loadMyUpcomingHikes and
      // watchMyUpcomingHikes so Firestore can authorize their query shapes.
      return signedIn() && (
        data.creatorPhone == phoneNumber()
        || phoneNumber() in data.participantPhones
      );
    }

    function ownHike(data) {
      return signedIn()
        && data.userId == request.auth.uid
        && data.userPhoneNumber == phoneNumber();
    }

    function ownedHikeSession(sessionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/hikeSessions/$(sessionId))
        && ownHike(
          get(/databases/$(database)/documents/hikeSessions/$(sessionId)).data
        );
    }

    function validDownloadedMapIdentity(downloadedMapId, data) {
      return ownHike(data)
        && data.trailId is string
        && data.trailId.size() > 0
        && data.trailId.size() <= 200
        && downloadedMapId == request.auth.uid + '_' + data.trailId
        && data.downloadedMapId == downloadedMapId;
    }

    function validHikeRouteCaptureWrite(captureId) {
      return ownedHikeSession(captureId)
        && request.resource.data.sessionId == captureId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userPhoneNumber == phoneNumber();
    }

    function ownUserIdAndPhone(data, phoneField) {
      return signedIn()
        && data.userId == request.auth.uid
        && data[phoneField] == phoneNumber();
    }

    function immutableHikeIdentity() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.userPhoneNumber == resource.data.userPhoneNumber
        && request.resource.data.sessionId == resource.data.sessionId;
    }

    function validHikeStatusTransition() {
      return request.resource.data.status == resource.data.status;
    }

    function validHikeTelemetryUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'monitoringHeartbeatAt', 'monitoringHeartbeatAtLocal',
        'monitoringLifecycleState', 'monitoringExpected',
        'monitoringFcmToken', 'terminationSignalNonce',
        'terminationSignalAt', 'terminationSignalAtLocal',
        'latestLocation', 'latestLocationUpdatedAt',
        'latestLocationUpdatedAtLocal', 'lastPathDeviation',
        'latestMotion',
        'lastPathDeviationAt', 'lastPathDeviationAtLocal',
        'pathDeviationAlertCount', 'updatedAt', 'updatedAtLocal'
      ]);
    }

    function validLastReadMapUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'lastReadAt'
        ]) || (
          request.resource.data.lastReadAt is map
          && request.resource.data.lastReadAt[phoneKey()] is string
          && (
            (!resource.data.keys().hasAny(['lastReadAt'])
              && request.resource.data.lastReadAt.keys().hasOnly([phoneKey()]))
            || (resource.data.lastReadAt is map
              && request.resource.data.lastReadAt.diff(
                resource.data.lastReadAt
              ).affectedKeys().hasOnly([phoneKey()]))
          )
        );
    }

    function validUnreadMapUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'unreadCount'
        ]) || (
          request.resource.data.unreadCount is map
          && request.resource.data.unreadCount[phoneKey()] == 0
          && (
            (!resource.data.keys().hasAny(['unreadCount'])
              && request.resource.data.unreadCount.keys().hasOnly([phoneKey()]))
            || (resource.data.unreadCount is map
              && request.resource.data.unreadCount.diff(
                resource.data.unreadCount
              ).affectedKeys().hasOnly([phoneKey()]))
          )
        );
    }

    function validParticipantChatMetadataUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAtLocal', 'lastMessageSenderPhone',
          'lastReadAt', 'unreadCount', 'updatedAt', 'updatedAtLocal'
        ])
        && validLastReadMapUpdate()
        && validUnreadMapUpdate()
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'lastMessage', 'lastMessageAtLocal', 'lastMessageSenderPhone'
          ])
          || request.resource.data.lastMessageSenderPhone == phoneNumber()
        );
    }

    function validChatAttachment(chatId) {
      return !request.resource.data.keys().hasAny(['attachment']) || (
        request.resource.data.attachment is map
        && request.resource.data.attachment.keys().hasOnly([
          'type', 'url', 'fileName', 'contentType', 'sizeBytes'
        ])
        && request.resource.data.attachment.type in [
          'image', 'video', 'document'
        ]
        && request.resource.data.attachment.url is string
        && request.resource.data.attachment.url.size() <= 2048
        && request.resource.data.attachment.url.matches(
          '^https://firebasestorage\\.googleapis\\.com/v0/b/'
          + 'hiker-circle\\.firebasestorage\\.app/o/group_chats%2F'
          + chatId + '%2Fattachments%2F.*'
        )
        && request.resource.data.attachment.fileName is string
        && request.resource.data.attachment.fileName.size() > 0
        && request.resource.data.attachment.fileName.size() <= 255
        && request.resource.data.attachment.contentType is string
        && request.resource.data.attachment.contentType.size() <= 150
        && request.resource.data.attachment.sizeBytes is int
        && request.resource.data.attachment.sizeBytes > 0
        && request.resource.data.attachment.sizeBytes <= 25 * 1024 * 1024
      );
    }

    // Shared previews are untrusted display data; opening always reads the real post.
    function validSharedCommunityPost() {
      return !request.resource.data.keys().hasAny(['sharedPost']) || (
        request.resource.data.sharedPost is map
        && request.resource.data.sharedPost.keys().hasAll(['postId', 'authorName', 'caption', 'trailName'])
        && request.resource.data.sharedPost.keys().hasOnly(['postId', 'authorName', 'caption', 'trailName'])
        && request.resource.data.sharedPost.postId is string
        && request.resource.data.sharedPost.postId.size() > 0
        && request.resource.data.sharedPost.postId.size() <= 200
        && !request.resource.data.sharedPost.postId.matches('.*[/\\x00-\\x1f].*')
        && request.resource.data.sharedPost.authorName is string
        && request.resource.data.sharedPost.authorName.size() > 0
        && request.resource.data.sharedPost.authorName.size() <= 160
        && request.resource.data.sharedPost.caption is string
        && request.resource.data.sharedPost.caption.size() <= 600
        && request.resource.data.sharedPost.trailName is string
        && request.resource.data.sharedPost.trailName.size() <= 160
      );
    }

    function validChatMessageCreate(chatId) {
      return request.resource.data.keys().hasOnly([
          'chatId', 'senderPhone', 'senderName', 'text', 'sentAtLocal',
          'isSystemMessage', 'seenBy', 'senderPhotoURL', 'attachment', 'sharedPost'
        ])
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000
        && (
          request.resource.data.text.size() > 0
          || request.resource.data.keys().hasAny(['attachment'])
        )
        && request.resource.data.sentAtLocal is string
        && request.resource.data.sentAtLocal.size() >= 20
        && request.resource.data.sentAtLocal.size() <= 40
        && request.resource.data.isSystemMessage is bool
        && (!request.resource.data.keys().hasAny(['senderPhotoURL'])
          || (request.resource.data.senderPhotoURL is string
            && request.resource.data.senderPhotoURL.size() <= 2048))
        && validChatAttachment(chatId)
        && validSharedCommunityPost();
    }

    function validEmergencyContact(contact) {
      return contact is map
        && contact.keys().hasOnly(['name', 'phoneNumber', 'relationship'])
        && contact.name is string
        && contact.name.size() > 0
        && contact.name.size() <= 100
        && contact.phoneNumber is string
        && contact.phoneNumber.matches('^\\+[1-9][0-9]{7,14}$')
        && contact.phoneNumber != phoneNumber()
        && contact.relationship is string
        && contact.relationship.size() <= 100;
    }

    function validEmergencyContacts(data) {
      return data.sos_contacts is list
        && data.sos_contacts.size() >= 1
        && data.sos_contacts.size() <= 3
        && data.sosContactsCount is int
        && data.sosContactsCount == data.sos_contacts.size()
        && (data.sos_contacts.size() < 1
          || validEmergencyContact(data.sos_contacts[0]))
        && (data.sos_contacts.size() < 2
          || validEmergencyContact(data.sos_contacts[1]))
        && (data.sos_contacts.size() < 3
          || validEmergencyContact(data.sos_contacts[2]));
    }

    function validEmergencyContactsOnCreate(data) {
      return !data.keys().hasAny(['sos_contacts', 'sosContactsCount'])
        || validEmergencyContacts(data);
    }

    function validEmergencyContactsOnUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'sos_contacts', 'sosContactsCount'
        ])
        || validEmergencyContacts(request.resource.data);
    }

    function validSosWhatsappNotes(data) {
      return data.sosWhatsappNotes is map
        && data.sosWhatsappNotes.keys().hasOnly(['manual', 'duress', 'medical'])
        && (!data.sosWhatsappNotes.keys().hasAny(['manual'])
          || (data.sosWhatsappNotes.manual is string
            && data.sosWhatsappNotes.manual.size() <= 240))
        && (!data.sosWhatsappNotes.keys().hasAny(['duress'])
          || (data.sosWhatsappNotes.duress is string
            && data.sosWhatsappNotes.duress.size() <= 240))
        && (!data.sosWhatsappNotes.keys().hasAny(['medical'])
          || (data.sosWhatsappNotes.medical is string
            && data.sosWhatsappNotes.medical.size() <= 240));
    }

    function validSosWhatsappNotesOnCreate(data) {
      return !data.keys().hasAny(['sosWhatsappNotes'])
        || validSosWhatsappNotes(data);
    }

    function validSosWhatsappNotesOnUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'sosWhatsappNotes'
        ])
        || validSosWhatsappNotes(request.resource.data);
    }

    function validPreferredTimeZone(data) {
      return data.preferredTimeZone is string
        && data.preferredTimeZone.size() > 0
        && data.preferredTimeZone.size() <= 80
        && data.preferredTimeZone.matches(
          '^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$'
        );
    }

    function validPreferredTimeZoneOnCreate(data) {
      return !data.keys().hasAny(['preferredTimeZone'])
        || validPreferredTimeZone(data);
    }

    function validPreferredTimeZoneOnUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'preferredTimeZone'
        ])
        || validPreferredTimeZone(request.resource.data);
    }

    function hasNoHazardReviewFields(data) {
      return !data.keys().hasAny([
        'adminNote', 'reviewedByAdminId', 'reviewedByAdminPhoneNumber',
        'reviewedAt', 'reviewedAtLocal'
      ]);
    }

    function ownAccount(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function accountFieldsOnly(data) {
      return data.keys().hasOnly([
        'phoneNumber', 'createdAt', 'createdAtLocal', 'isAdmin', 'isSuperAdmin', 'role', 'roles',
        'accountDisabled', 'status'
      ]);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow create: if accountFieldsOnly(request.resource.data) && (
        (admin() && !request.resource.data.keys().hasAny(['isAdmin', 'isSuperAdmin', 'role', 'roles'])) || (ownAccount(userId)
          && request.resource.data.phoneNumber == phoneNumber()
          && request.resource.data.keys().hasOnly([
            'phoneNumber', 'createdAt', 'createdAtLocal'
          ]))
      );
      allow update: if admin() && accountFieldsOnly(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isSuperAdmin', 'role', 'roles']);
      allow delete: if admin() && !administratorAccount(resource.data);
    }

    function profileFieldsOnly(data) {
      return data.keys().hasOnly([
        'profile', 'profileSetupCompleted', 'profileUpdatedAt',
        'profileUpdatedAtLocal', 'requiresOnboarding', 'onboardingVersion',
        'onboardingCompletedAt', 'onboardingCompletedAtLocal'
      ]);
    }

    function deviceFieldsOnly(data) {
      return data.keys().hasOnly([
        'boundAppInstanceId', 'boundAppInstanceUpdatedAt',
        'boundAppInstanceUpdatedAtLocal', 'previousBoundAppInstanceId',
        'deviceReboundAt', 'deviceReboundAtLocal', 'deviceRebindVerifiedBy',
        'fcmTokenByAppId', 'fcmTokenByAppIdCapabilities', 'lastFcmTokenUpdatedAt', 'lastFcmTokenUpdatedAtLocal',
        'lastSignedInAt', 'lastSignedInAtLocal'
      ]) && (!data.keys().hasAny(['fcmTokenByAppId'])
        || data.fcmTokenByAppId is map);
    }

    function preferenceFieldsOnly(data) {
      return data.keys().hasOnly([
        'preferredTimeZone', 'preferredTimeZoneUpdatedAt',
        'preferredTimeZoneUpdatedAtLocal', 'groupChatNotificationsEnabled',
        'groupChatNotificationSettingsUpdatedAt',
        'groupChatNotificationSettingsUpdatedAtLocal', 'groupChatMutedUntil',
        'pinnedChats', 'autoShareLiveLocationOnHikeStart',
        'autoShareLiveLocationPreferenceUpdatedAt',
        'autoShareLiveLocationPreferenceUpdatedAtLocal'
      ]) && validPreferredTimeZoneOnCreate(data);
    }

    function sosFieldsOnly(data) {
      return data.keys().hasOnly(['sosNoteOperations', 'sosContactsCloudOnly',
        'sos_contacts', 'sosContactsCount', 'sosContactsUpdatedAt',
        'sosContactsUpdatedAtLocal', 'sosWhatsappNotes',
        'sosWhatsappNotesUpdatedAt', 'sosWhatsappNotesUpdatedAtLocal',
        'latestSosAlertPath', 'recentSosAlertPaths', 'sosAlertsCount',
        'sosAlertsUpdatedAt', 'sosAlertsUpdatedAtLocal'
      ]);
    }

    function locationFieldsOnly(data) {
      return data.keys().hasOnly([
        'liveLocation', 'liveLocationEnabled', 'liveLocationShareId',
        'liveLocationShareUrl', 'liveLocationUpdatedAt',
        'liveLocationUpdatedAtLocal', 'liveLocationExpiresAt',
        'liveLocationExpiresAtLocal', 'liveLocationStartedAt',
        'liveLocationStartedAtLocal'
      ]);
    }

    match /users/{userId}/modules/{moduleId} {
      // Security contains password/recovery hashes and security audit state.
      // Neither account owners nor mobile administrators can fetch it.
      allow read: if moduleId in [
        'profile', 'devices', 'preferences', 'safety', 'sos', 'location',
        'social', 'achievements'
      ] && signedIn() && (ownAccount(userId) || admin());
      allow create, update: if ownAccount(userId) && (
        (moduleId == 'profile' && profileFieldsOnly(request.resource.data))
        || (moduleId == 'devices' && deviceFieldsOnly(request.resource.data)
          && (request.method == 'create'
            ? request.resource.data.keys().hasOnly(['fcmTokenByAppId', 'fcmTokenByAppIdCapabilities', 'lastFcmTokenUpdatedAt', 'lastFcmTokenUpdatedAtLocal'])
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokenByAppId', 'fcmTokenByAppIdCapabilities', 'lastFcmTokenUpdatedAt', 'lastFcmTokenUpdatedAtLocal'])))
        || (moduleId == 'preferences'
          && preferenceFieldsOnly(request.resource.data))
        || (moduleId == 'safety' && request.resource.data.keys().hasOnly([
          'teamSafetyPreferences', 'teamSafetyPreferencesUpdatedAt',
          'teamSafetyPreferencesUpdatedAtLocal'
        ]))
        || (moduleId == 'location' && locationFieldsOnly(request.resource.data)
          && (request.method == 'create'
            ? !request.resource.data.keys().hasAny(['liveLocationStartedAt', 'liveLocationStartedAtLocal'])
            : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['liveLocationStartedAt', 'liveLocationStartedAtLocal'])))
      );
      allow create: if ownAccount(userId) && moduleId == 'sos'
        && !request.resource.data.keys().hasAny(['sosNoteOperations', 'sosContactsCloudOnly'])
        && sosFieldsOnly(request.resource.data)
        && validEmergencyContactsOnCreate(request.resource.data)
        && validSosWhatsappNotesOnCreate(request.resource.data);
      allow update: if ownAccount(userId) && moduleId == 'sos'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sosNoteOperations', 'sosContactsCloudOnly'])
        && (!resource.data.get('sosContactsCloudOnly', false)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sos_contacts', 'sosContactsCount']))
        && (!resource.data.keys().hasAny(['sosNoteOperations'])
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sosWhatsappNotes']))
        && sosFieldsOnly(request.resource.data)
        && validEmergencyContactsOnUpdate()
        && validSosWhatsappNotesOnUpdate();
      allow delete: if false;
    }

    // Authentication factors, OTP/session material, and WebAuthn challenges
    // are backend-only. They must never be readable through a mobile SDK,
    // including by the account owner or an administrator client session.
    match /users/{userId}/authFactors/{factorId} {
      allow read, write: if false;
    }

    match /mfaLoginSessions/{sessionId} {
      allow read, write: if false;
    }

    match /mfaEnrollmentChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /mfaAuthenticationChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /passwordResetChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /passwordResetSessions/{sessionId} {
      allow read, write: if false;
    }

    match /passwordResetPasskeyChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /live_location_shares/{shareId} {
      // Knowing an opaque share link permits one document, never enumeration.
      allow get: if (
        resource.data.isActive == true
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time
      ) || (signedIn() && resource.data.ownerUserId == request.auth.uid) || admin();
      allow list: if (signedIn() && resource.data.ownerUserId == request.auth.uid) || admin();
      // Activation and expiry come from the authenticated server callable.
      allow create: if false;
      allow update: if signedIn()
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.phoneNumber == resource.data.phoneNumber
        && request.resource.data.shareId == resource.data.shareId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'createdAt', 'createdAtLocal', 'routeRetentionExpiresAt'
        ])
        && request.resource.data.expiresAt is timestamp
        && (
          (resource.data.isActive == true && request.resource.data.isActive == true
            && resource.data.expiresAt > request.time
            && request.resource.data.expiresAt == resource.data.expiresAt)
          || (request.resource.data.isActive == false
            && request.resource.data.expiresAt <= resource.data.expiresAt)
        );
      allow delete: if admin() || (signedIn() && resource.data.ownerUserId == request.auth.uid);

      match /live_location_route_chunks/{chunkId} {
        // Only a known, currently live share may expose its public projection.
        // Expiry/revocation apply immediately even before TTL removes chunks.
        function sharedRouteIsActive() {
          let share = get(/databases/$(database)/documents/live_location_shares/$(shareId));
          return share.data.isActive == true
            && share.data.expiresAt is timestamp
            && share.data.expiresAt > request.time;
        }
        allow get, list: if sharedRouteIsActive();
        allow create, update, delete: if false;
      }
    }

    match /trails/{trailId} {
      allow read: if signedIn();
      allow write: if admin();

      match /checkpointWeather/{checkpointKey} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /routeGeometry/{geometryId} {
        allow read: if signedIn();
        allow write: if admin();
        match /chunks/{chunkId} { allow read: if signedIn(); allow write: if admin(); }
      }
    }

    match /hikeSessions/{sessionId} {
      match /snapshotArchives/{archiveId} {
        // Archived forecast series are private maintenance data, not public history.
        allow read, write: if false;
      }
      allow read: if ownHike(resource.data) || admin();
      // Session creation is a callable transaction so a client cannot forge
      // lifecycle state or server monitoring fields.
      allow create: if false;
      allow update: if immutableHikeIdentity()
        && validHikeStatusTransition()
        && validHikeTelemetryUpdate()
        && (ownHike(resource.data) || admin());
      // Backend cleanup writes a terminal tombstone before deletion. A mobile
      // delete could otherwise remove an active record and later resurrect it.
      allow delete: if false;
    }

    match /footprints/{footprintId} {
      allow read: if admin() || (signedIn()
        && ownHike(get(/databases/$(database)/documents/hikeSessions/$(resource.data.sessionId)).data));
      allow write: if false;
    }

    match /checkIns/{checkInId} {
      allow read: if ownHike(resource.data) || admin();
      // Check-ins affect safety metrics and achievements, so creation and all
      // mutations go through recordActiveHikeCheckIn.
      allow write: if false;
    }

    match /hazardReports/{hazardId} {
      allow read: if signedIn();
      // Installed older clients may submit their original text-only report.
      // They cannot manufacture votes, media, resolutions or expiry metadata.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['hazardId','trailId','trailName','reportedBy','reportedByPhoneNumber','hazardType','description','severity','latitude','longitude','location','status','reportLabel','reportedAt','reportedAtLocal'])
        && request.resource.data.hazardId == hazardId
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.reportedByPhoneNumber == phoneNumber()
        && request.resource.data.status == 'unverified'
        && request.resource.data.reportedAt == request.time
        && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.description is string && request.resource.data.description.size() <= 1000;
      allow update, delete: if admin();
      match /updates/{updateId} {
        allow read: if signedIn();
        allow write: if false;
      }
      match /votes/{voteId} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow write: if false;
      }
    }

    // Creation and all participant/phase mutations are authenticated Cloud
    // Functions transactions. Clients receive snapshots but cannot rewrite a
    // teammate or manufacture notification recipients.
    match /teamHikeSessions/{sessionId} {
      allow read: if participant(resource.data) || admin();
      allow write: if false;
    }

    match /fcmOutbox/{messageId} {
      allow read, write: if false;
    }

    match /teamHikeActionRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /upcomingHikeRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /directChatActionRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /activeHikeStartRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /hikeSessionRecoveryRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /buddyRequestRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /sosMessageRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // Server-owned SOS contact receipts expose only this signed-in owner's confirmation results.
    match /sosDeliveryReceipts/{ownerUid}/dispatches/{dispatchId} {
      allow read: if signedIn() && request.auth.uid == ownerUid;
      allow write: if false;
    }

    match /sosWhatsAppDispatches/{dispatchId} {
      allow read: if admin();
      allow write: if false;
    }

    match /achievementEventReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /communityCounterEventReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /hikeSessionTerminalStates/{sessionId} {
      allow read, write: if false;
    }

    match /trailRequests/{requestId} {
      allow read: if signedIn() && (admin() || resource.data.ownerId == request.auth.uid);
      allow create, delete: if false;
      allow update: if admin() && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'reviewedAt', 'reviewedAtLocal', 'reviewedByAdminId', 'publishedTrailId', 'reviewNote']);
      match /routeChunks/{chunkId} {
        function parentRequest() { return get(/databases/$(database)/documents/trailRequests/$(requestId)); }
        allow read: if signedIn() && (admin() || parentRequest().data.ownerId == request.auth.uid);
        allow create, update: if signedIn() && parentRequest().data.ownerId == request.auth.uid
          && parentRequest().data.status == 'uploading'
          && request.resource.data.keys().hasOnly(['index','points'])
          && request.resource.data.index is int && request.resource.data.index >= 0
          && request.resource.data.index < parentRequest().data.chunkCount
          && chunkId == string(request.resource.data.index)
          && request.resource.data.points is list && request.resource.data.points.size() > 0
          && request.resource.data.points.size() <= 500;
        allow delete: if false;
      }
    }

    match /communityModerationReviews/{reviewId} {
      allow read: if admin();
      allow write: if false;
    }

    match /communityModerationStatus/{statusId} {
      allow read: if admin();
      allow write: if false;
    }

    match /communityPosts/{postId} {
      allow read: if signedIn() && (
        resource.data.visibility == 'public'
        || resource.data.authorId == request.auth.uid
        || admin()
      );
      // Callables validate ownership, uploaded media and canonical hike
      // snapshots, and update reaction/comment counters atomically.
      allow create, update, delete: if false;

      match /comments/{commentId} {
        function parentPost() {
          return get(/databases/$(database)/documents/communityPosts/$(postId));
        }

        allow read: if signedIn() && (
          parentPost().data.visibility == 'public'
          || parentPost().data.authorId == request.auth.uid
          || admin()
        );
        allow create, update, delete: if false;
      }

      match /reactions/{userId} {
        // A user only needs their own reaction state. Public counts live on
        // the parent; the membership list is never exposed to the feed.
        allow get: if signedIn() && request.auth.uid == userId
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.visibility == 'public';
        allow list, create, update, delete: if false;
      }
    }

    match /achievements/{achievementId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /userAchievements/{userAchievementId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid || admin()
      );
      allow write: if false;
    }

    match /networkObservations/{observationId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || admin());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /downloadedMaps/{downloadedMapId} {
      allow read: if ownHike(resource.data) || admin();
      allow create: if validDownloadedMapIdentity(
        downloadedMapId,
        request.resource.data
      );
      // Validate the canonical request rather than trusting legacy resource
      // ownership, so the rightful account can replace an old malicious
      // preclaim at its deterministic document ID.
      allow update: if validDownloadedMapIdentity(
        downloadedMapId,
        request.resource.data
      );
      allow delete: if ownHike(resource.data) || admin();
    }

    match /sosAlerts/{alertId} {
      // Queries can prove the immutable userId predicate; requiring a second
      // phone predicate here would reject the app's owner-scoped log query.
      allow read: if (
        signedIn() && resource.data.userId == request.auth.uid
      ) || admin();
      allow create: if ownUserIdAndPhone(request.resource.data, 'phoneNumber');
      allow update: if ownUserIdAndPhone(resource.data, 'phoneNumber')
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.phoneNumber == resource.data.phoneNumber;
      allow delete: if false;
    }

    match /whatsAppMessageLogs/{logId} {
      // Legacy client-reported logs are not authoritative. New delivery audit
      // entries live in the server-only sosWhatsAppDispatches collection.
      allow read: if admin();
      allow write: if false;
    }

    match /hikeRouteCaptures/{captureId} {
      allow read: if ownHike(resource.data) || admin();
      // The canonical parent session is the authority. Depending on the
      // existing capture would let a legacy attacker-owned preclaim block the
      // real session owner from replacing or deleting it.
      allow create, update: if validHikeRouteCaptureWrite(captureId);
      allow delete: if ownedHikeSession(captureId);
    }

    // Scheduling and membership joins are rate-limited server callables.
    match /upcomingHikes/{hikeId} {
      allow read: if upcomingHikeParticipant(resource.data) || admin();
      allow write: if false;

      match /reminderPreferences/{userId} {
        function hike() {
          return get(
            /databases/$(database)/documents/upcomingHikes/$(hikeId)
          );
        }

        // Version two has only first/frequency; old clients retain their limits.
        function validConfig(data) {
          let version = data.get('schemaVersion', 1);
          return data.enabled is bool
            && data.firstReminderMinutesBefore is int
            && data.firstReminderMinutesBefore in [
              5, 10, 15, 30, 60, 120, 180, 360, 720, 1440
            ]
            && data.repeatIntervalMinutes is int
            && data.repeatIntervalMinutes in [0, 15, 30, 60, 120, 360]
            && version is int
            && ((version == 2
                && data.repeatIntervalMinutes < data.firstReminderMinutesBefore
                && !data.keys().hasAny([
                  'finalReminderMinutesBefore', 'maximumReminders'
                ]))
              || (version == 1
                && data.finalReminderMinutesBefore is int
                && data.finalReminderMinutesBefore in [5, 10, 15, 30, 60]
                && data.finalReminderMinutesBefore
                  <= data.firstReminderMinutesBefore
                && data.maximumReminders is int
                && data.maximumReminders in [1, 2, 3, 4, 5, 6, 7, 8]));
        }

        function ownReminderPath() {
          return signedIn()
            && userId == request.auth.uid
            && exists(
              /databases/$(database)/documents/upcomingHikes/$(hikeId)
            )
            && upcomingHikeParticipant(hike().data);
        }

        function ownReminder(data) {
          return ownReminderPath()
            && data.ownerUserId == request.auth.uid
            && data.ownerPhoneNumber == phoneNumber()
            && data.hikeId == hikeId;
        }

        // Authorize the path rather than resource.data so a first read of a
        // not-yet-created preference correctly returns "not found".
        allow read: if ownReminderPath() || admin();
        allow create: if ownReminder(request.resource.data)
          && validConfig(request.resource.data)
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'enabled', 'firstReminderMinutesBefore',
            'repeatIntervalMinutes', 'finalReminderMinutesBefore',
            'maximumReminders', 'hikeId', 'ownerUserId',
            'ownerPhoneNumber', 'updatedAt', 'updatedAtLocal'
          ]);
        allow update: if ownReminder(resource.data)
          && ownReminder(request.resource.data)
          && validConfig(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'schemaVersion', 'enabled', 'firstReminderMinutesBefore',
            'repeatIntervalMinutes', 'finalReminderMinutesBefore',
            'maximumReminders', 'updatedAt', 'updatedAtLocal'
          ]);
        allow delete: if false;
      }
    }

    match /groupChats/{chatId} {
      allow read: if groupChatParticipant(resource.data) || admin();
      allow create: if false;
      allow update: if request.resource.data.creatorPhone == resource.data.creatorPhone
        && request.resource.data.participantPhones == resource.data.participantPhones
        && request.resource.data.hikeSessionId == resource.data.hikeSessionId
        && request.resource.data.chatType == resource.data.chatType
        && (
          admin() || (
            groupChatParticipant(resource.data)
            && validParticipantChatMetadataUpdate()
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        function chat() {
          return get(/databases/$(database)/documents/groupChats/$(chatId));
        }

        allow read: if groupChatParticipant(chat().data);
        allow create: if signedIn()
          && groupChatParticipant(chat().data)
          && validChatMessageCreate(chatId)
          && request.resource.data.chatId == chatId
          && request.resource.data.senderPhone == phoneNumber()
          && request.resource.data.isSystemMessage == false
          && request.resource.data.seenBy is list
          && request.resource.data.seenBy.size()
            == request.resource.data.seenBy.toSet().size()
          && request.resource.data.seenBy.toSet().hasOnly([phoneNumber()]);
        allow update: if signedIn()
          && groupChatParticipant(chat().data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
          && request.resource.data.seenBy is list
          && resource.data.seenBy is list
          && request.resource.data.seenBy.size()
            == request.resource.data.seenBy.toSet().size()
          && chat().data.participantPhones is list
          && chat().data.participantPhones.toSet().hasAll(
            request.resource.data.seenBy.toSet()
          )
          && request.resource.data.seenBy.toSet().hasAll(resource.data.seenBy.toSet())
          && request.resource.data.seenBy.toSet().difference(
            resource.data.seenBy.toSet()
          ).hasOnly([phoneNumber()]);
        allow delete: if admin() || (
          signedIn()
          && groupChatParticipant(chat().data)
          && resource.data.senderPhone == phoneNumber()
        );
      }
    }

    match /appFeedback/{reportId} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/appFeedback/$(reportId))
        || resource.data.uid == request.auth.uid || admin()
      );
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'category', 'message', 'screenshotPath', 'platform', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'category', 'message', 'screenshotPath', 'platform', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['Problem', 'Suggestion', 'Other']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 4000
        && request.resource.data.platform in ['web', 'android', 'iOS', 'macOS', 'windows', 'linux', 'fuchsia']
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time
        && (request.resource.data.screenshotPath == ''
          || request.resource.data.screenshotPath == 'app_feedback/' + request.auth.uid + '/' + reportId + '/screenshot.png');
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['New', 'In review', 'Resolved'];
      allow delete: if admin();
    }

    // Hash manifests contain private query identities and are served only by authorized callables.
    match /userRoleHistory/{document} {
      allow read, write: if false;
    }
    match /syncManifests/{document} {
      allow read, write: if false;
    }
    match /syncManifestSources/{document} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
