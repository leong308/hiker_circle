// Cloud Storage authorization: current mobile session authority plus feature-specific owner, media, and size constraints.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && request.auth.token.phoneNumber == request.auth.uid
        && request.auth.token.get('mfa', false) == true
        && request.auth.token.get('mobileSessionId', '') != ''
        && firestore.get(/databases/(default)/documents/mobileSessions/$(request.auth.uid)).data.activeSessionId
          == request.auth.token.mobileSessionId;
    }

    function admin() {
      return signedIn()
        && request.auth.token.keys().hasAny(['isAdmin'])
        && request.auth.token.isAdmin == true;
    }

    function chatMember(chatId) {
      return signedIn()
        && firestore.get(
          /databases/(default)/documents/groupChats/$(chatId)
        ).data.participantPhones.hasAny([request.auth.token.phoneNumber]);
    }

    function supportedImage(contentType, fileName) {
      return (
        contentType == 'image/jpeg'
          && fileName.lower().matches('.*\\.(jpg|jpeg)$')
      ) || (
        contentType == 'image/png'
          && fileName.lower().matches('.*\\.png$')
      ) || (
        contentType == 'image/gif'
          && fileName.lower().matches('.*\\.gif$')
      ) || (
        contentType == 'image/webp'
          && fileName.lower().matches('.*\\.webp$')
      ) || (
        contentType == 'image/heic'
          && fileName.lower().matches('.*\\.heic$')
      ) || (
        contentType == 'image/heif'
          && fileName.lower().matches('.*\\.heif$')
      );
    }

    function supportedVideo(contentType, fileName) {
      return (
        contentType == 'video/mp4'
          && fileName.lower().matches('.*\\.mp4$')
      ) || (
        contentType == 'video/quicktime'
          && fileName.lower().matches('.*\\.mov$')
      ) || (
        contentType == 'video/x-m4v'
          && fileName.lower().matches('.*\\.m4v$')
      );
    }

    function supportedDocument(contentType, fileName) {
      return (
        contentType == 'application/pdf'
          && fileName.lower().matches('.*\\.pdf$')
      ) || (
        contentType == 'application/msword'
          && fileName.lower().matches('.*\\.doc$')
      ) || (
        contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          && fileName.lower().matches('.*\\.docx$')
      ) || (
        contentType == 'application/vnd.ms-excel'
          && fileName.lower().matches('.*\\.xls$')
      ) || (
        contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          && fileName.lower().matches('.*\\.xlsx$')
      ) || (
        contentType == 'text/plain'
          && fileName.lower().matches('.*\\.txt$')
      );
    }

    match /trail_covers/{trailId}/{imageName} {
      allow read: if signedIn();
      allow create, update: if admin()
        && request.resource.size <= 10 * 1024 * 1024
        && supportedImage(request.resource.contentType, imageName);
      allow delete: if admin();
    }
    match /trail_cautions/{uid}/{hazardId}/{fileName} {
      allow read: if signedIn();
      allow create: if resource == null && signedIn() && request.auth.uid == uid
        && request.resource.metadata.ownerUid == uid
        && request.resource.metadata.hazardId == hazardId
        && request.resource.size > 0 && request.resource.size <= 50 * 1024 * 1024
        && (supportedImage(request.resource.contentType, fileName) || supportedVideo(request.resource.contentType, fileName));
      allow update: if false;
      allow delete: if admin();
    }

    match /profile_photos/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && supportedImage(request.resource.contentType, fileName);
      allow delete: if signedIn()
        && (request.auth.uid == userId || admin());
    }

    match /community_hikes/{userId}/{sessionId}/{fileName} {
      allow read: if signedIn();
      // Existing images keep their original URLs; all new media is scoped to
      // its post rather than sharing an ambiguous hike directory.
      allow create, update: if false;
      allow delete: if admin();
    }

    match /community_posts/{userId}/{postId}/{fileName} {
      allow read: if signedIn();
      allow create: if resource == null && signedIn()
        && request.auth.uid == userId
        && request.resource.metadata.ownerUserId == userId
        && request.resource.metadata.postId == postId
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && supportedImage(request.resource.contentType, fileName);
      allow update: if false;
      allow delete: if admin() || (signedIn() && request.auth.uid == userId
        && resource.metadata.ownerUserId == userId
        && !firestore.exists(/databases/(default)/documents/communityPosts/$(postId)));
    }

    match /group_chats/{chatId}/attachments/{fileName} {
      allow read: if chatMember(chatId);
      allow create: if resource == null
        && chatMember(chatId)
        && request.resource.metadata.senderPhone == request.auth.token.phoneNumber
        && request.resource.size <= 25 * 1024 * 1024
        && (
          supportedImage(request.resource.contentType, fileName)
          || supportedVideo(request.resource.contentType, fileName)
          || supportedDocument(request.resource.contentType, fileName)
        );
      allow update: if false;
      allow delete: if admin() || (
        chatMember(chatId)
        && resource.metadata.senderPhone == request.auth.token.phoneNumber
      );
    }

    match /app_feedback/{uid}/{reportId}/screenshot.png {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/png'
        && !firestore.exists(/databases/(default)/documents/appFeedback/$(reportId));
      allow delete: if admin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
