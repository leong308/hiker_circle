	<string>HikerCircle uses the camera for buddy QR scanning and the flashlight for manual SOS alerts.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>HikerCircle uses your location for trail context, nearby safety updates, and SOS location sharing while you use the app.</string>
	<key>NSMotionUsageDescription</key>
	<string>HikerCircle uses motion sensors during active hikes to detect a possible fall followed by stillness and start a cancellable SOS countdown.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
