<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/three_button_sos_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/three_button_sos_widget_background"
    android:contentDescription="HikerCircle SOS actions"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:gravity="start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="SOS with HikerCircle"
        android:textColor="#FFFFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/instant_sos_widget_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/three_button_sos_instant_background"
            android:clickable="true"
            android:contentDescription="Send Instant SOS"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="SOS"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Instant"
                android:textColor="#DBFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/medical_sos_widget_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/three_button_sos_medical_background"
            android:clickable="true"
            android:contentDescription="Request Medical Help"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="+"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Medical"
                android:textColor="#DBFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/duress_sos_widget_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/three_button_sos_duress_background"
            android:clickable="true"
            android:contentDescription="Send Duress SOS"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="!"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Duress"
                android:textColor="#DBFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
