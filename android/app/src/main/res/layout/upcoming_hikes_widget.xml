<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/upcoming_widget_root"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/upcoming_widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="UPCOMING HIKES" android:textStyle="bold" android:textColor="@color/upcoming_accent" android:textSize="12sp"/>
  <TextView android:id="@+id/upcoming_widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4 planned" android:textColor="@color/upcoming_secondary" android:textSize="11sp"/>
 </LinearLayout>
 <TextView android:id="@+id/upcoming_widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="24dp" android:text="Room for your next adventure\nSchedule hikes in HikerCircle to see them here." android:textSize="16sp" android:textColor="@color/upcoming_fg" android:visibility="gone"/>
 <LinearLayout android:id="@+id/upcoming_widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingTop="10dp">
  <include layout="@layout/upcoming_hike_widget_row"/>
  <include layout="@layout/upcoming_hike_widget_row"/>
  <include layout="@layout/upcoming_hike_widget_row"/>
  <include layout="@layout/upcoming_hike_widget_row"/>
 </LinearLayout>
 <TextView android:id="@+id/upcoming_widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap a hike to review preparation →" android:textSize="11sp" android:textColor="@color/upcoming_secondary"/>
</LinearLayout>
