<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/upcoming_row_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:orientation="horizontal" android:gravity="center_vertical">
 <LinearLayout android:layout_width="42dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
  <TextView android:id="@+id/upcoming_row_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SEP" android:textSize="10sp" android:textColor="@color/upcoming_accent"/>
  <TextView android:id="@+id/upcoming_row_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="21" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/upcoming_accent"/>
 </LinearLayout>
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
  <TextView android:id="@+id/upcoming_row_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your upcoming trail" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/upcoming_fg"/>
  <TextView android:id="@+id/upcoming_row_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="08:30 · 5.2 km" android:textSize="12sp" android:paddingTop="4dp" android:textColor="@color/upcoming_secondary"/>
 </LinearLayout>
 <TextView android:layout_width="16dp" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="@color/upcoming_secondary"/>
</LinearLayout>
