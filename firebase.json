{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "hiker-circle",
          "appId": "1:41069899337:android:f6fc9a19684233d8a61998",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "hiker-circle",
          "configurations": {
            "android": "1:41069899337:android:f6fc9a19684233d8a61998",
            "ios": "1:41069899337:ios:1633f87257716481a61998",
            "macos": "1:41069899337:ios:1633f87257716481a61998",
            "web": "1:41069899337:web:04b79b9aaf104702a61998",
            "windows": "1:41069899337:web:19643ebb35c1f03aa61998"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "predeploy": [
      "node scripts/prepare_firebase_hosting.js"
    ],
    "ignore": [
      "firebase.json",
      "**/.git/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/internal/app-showcase{,/**}",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Cache-Control", "value": "private, no-store" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/internal/app-showcase/media/*.mp4",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" },
          { "key": "Content-Type", "value": "video/mp4" }
        ]
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/get-app",
        "destination": "/get-app.html"
      },
      {
        "source": "/api/public-stats",
        "function": {
          "functionId": "getPublicHikerCircleStats",
          "region": "us-central1"
        }
      },
      {
        "source": "/privacy",
        "destination": "/privacy-policy.html"
      },
      {
        "source": "/privacy-policy",
        "destination": "/privacy-policy.html"
      },
      {
        "source": "/live-location",
        "destination": "/live-location.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
