    "violence": {
      "label": "Threats & graphic violence",
      "reason": "Possible threat or graphic violence",
      "severity": "high",
      "description": "Threats to harm people, encouragement of self-harm and graphic violence. Ordinary hiking or photography terms do not match on their own.",
