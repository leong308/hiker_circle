      "patterns": [
        {
          "id": "pattern:dangerous_instruction",
          "label": "Instruction to ignore a safety warning",
          "expression": "\\b(?:ignore|disable|abaikan|matikan)\\s+(?:all\\s+|the\\s+|semua\\s+)?(?:lightning|flood|landslide|cuaca|banjir|tanah\\s+runtuh)\\s+(?:warnings?|alerts?|alarms?|amaran)\\b"
        }
