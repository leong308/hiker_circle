        "杀死你",
        "砍死你",
        "自杀吧"
      ],
      "patterns": [
        {
          "id": "pattern:direct_threat",
          "label": "Direct threat of harm",
          "expression": "\\b(?:i(?:'ll|\\s+will|\\s+am\\s+going\\s+to)|we(?:'ll|\\s+will)|aku\\s+(?:akan|nak)|saya\\s+akan)\\s+(?:kill|stab|shoot|hurt|attack|rape|bunuh|tikam|tembak)\\s+(?:you|him|her|them|kau|awak|dia|mereka)\\b"
        }
