    "privacy": {
      "label": "Personal information exposure",
      "reason": "Possible exposure of personal or sensitive information",
      "severity": "medium",
      "description": "The existing sensitive-information phrases and email, phone and coordinate patterns. Evidence stores the rule name rather than the private value.",
      "keywords": [
        "my name is",
        "nama saya",
        "password",
        "kata laluan",
        "otp",
        "verification code",
        "authenticator",
        "diagnosed",
        "diagnosis",
        "medical record",
        "my injury",
        "my illness",
        "alamat rumah",
        "home address",
        "ic number",
        "passport",
        "nombor ic",
        "nombor pasport",
        "身份证号码",
        "家庭住址",
        "验证码",
        "密码"
      ],
      "patterns": [
        {
          "id": "pattern:email_address",
          "label": "Email address pattern",
          "expression": "[\\w.+-]+@[\\w.-]+\\.[a-z]{2,}"
        },
        {
          "id": "pattern:phone_number",
          "label": "Phone number pattern",
          "expression": "(?:\\+?\\d[\\d ().-]{6,}\\d)"
        },
        {
          "id": "pattern:coordinates",
          "label": "Coordinate pattern",
          "expression": "-?\\d{1,3}\\.\\d{3,}\\s*[,/]\\s*-?\\d{1,3}\\.\\d{3,}"
        }
      ]
    },
    "unsafe_advice": {
      "label": "Dangerous hiking advice",
      "reason": "Potentially dangerous advice",
      "severity": "high",
      "respectNegation": true,
      "description": "Encouragement to ignore critical warnings, consume unsafe water, leave emergency equipment behind or cross dangerous water.",
      "keywords": [
        "ignore weather warnings",
        "ignore lightning warnings",
        "ignore flood warnings",
        "turn off all safety alerts",
        "disable all safety alerts",
        "drink untreated river water",
        "hike without water",
